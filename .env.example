# ==============================================================================
# System 1 Core Engine Environment Configuration
# ==============================================================================
# Copy this file to .env or export these in your shell profile (~/.bashrc, ~/.zshrc)

# 1. TypeSafe Jev (Primary System 1 Decision Engine via OpenRouter Decisions API)
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
JEV_MODEL=typesafe/jev-1.14

# 2. ScaleDown (Context Compression & Secondary Classifier)
# Get your API key at: https://scaledown.xyz
SCALEDOWN_API_KEY=your_scaledown_api_key_here

# 3. Optional: Path to custom offline skills / runbook directory
# Defaults to ~/.config/system1/skills or ./skills
SYSTEM1_SKILLS_PATH=
